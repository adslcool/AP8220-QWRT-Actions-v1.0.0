#!/bin/sh /etc/rc.common
START=49
STOP=11
USE_PROCD=1
start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'aliyun,ap8220' ] || return 1
	[ "$(uci -q get usteer.@usteer[0].enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/ap8220-usteer-bridge.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
service_triggers() {
	procd_add_reload_trigger usteer
}
