#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
START=99
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	if [ "$(uci -q get ap8220_ap.core.initialized)" = 1 ] &&
		[ "$(uci -q get ap8220_ap.core.wifi_security_schema)" = 1 ]; then return 0; fi
	procd_open_instance
	procd_set_param command /usr/sbin/ap8220-ap wait-wifi
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
