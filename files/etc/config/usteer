config usteer 'main'
	option enabled '1'
	option network 'lan'
	option local_mode '0'
	option syslog '1'
	option ipv6 '0'
	option debug_level '2'
	option local_sta_update '2000'
	option remote_update_interval '2000'
	option remote_node_timeout '10'
	option max_neighbor_reports '8'
	# QCA bridge: neighbor synchronization and advisory BTM responses.
	# Probe/auth veto and forced disconnect are not available.
	option assoc_steering '0'
	option probe_steering '0'
	option initial_connect_delay '0'
	option min_connect_snr '0'
	option min_snr '0'
	option load_kick_enabled '0'
	option aggressiveness '1'
	# Automatic steering waits for device validation of actual driver RSSI.
	option roam_scan_snr '0'
	option roam_trigger_snr '0'
	option band_steering_interval '0'
	option link_measurement_interval '0'
